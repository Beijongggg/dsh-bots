    {
      "taskId": "TK-17b00001",
      "mechanism": "multi-hop-research",
      "brief": {
        "goal": "对 dsh-bots 仓库的十个子系统各做一次独立机制调查并汇总为带交叉引用的总报告：子系统＝宿主适配面／任务台账／复核件套／权限四层／邮件面／记忆与知识层／探针面／恒久性与模型更迭／简报与派单／重建与切换（按 docs/agents/codebase-map.md 模块职责划分）；每子系统一节、全报告不少于 10 节、每节含机制描述与至少 3 个文件坐标引用，并给出各子系统的关键不变量与已知留界",
        "deliverables": [
          {
            "format": "markdown",
            "location": "bots/knowledge/reports/R-2026-104.md"
          }
        ],
        "sources": [
          {
            "tool": "file",
            "ref": "docs/agents/codebase-map.md"
          },
          {
            "tool": "spec",
            "ref": ".scratch/org-v2/spec.md"
          },
          {
            "tool": "issue",
            "ref": "org-v2-build/17"
          }
        ],
        "boundaries": "只读调查＋写报告；不改代码与配置；不触真实运行面",
        "acceptance": [
          {
            "probe": "fs.contains",
            "args": {
              "location": "bots/knowledge/reports/R-2026-104.md",
              "text": "子系统"
            }
          },
          {
            "probe": "fs.contains",
            "args": {
              "location": "bots/knowledge/reports/R-2026-104.md",
              "text": "不变量"
            }
          },
          {
            "probe": "fs.contains",
            "args": {
              "location": "bots/knowledge/reports/R-2026-104.md",
              "text": "留界"
            }
          }
        ],
        "reviewPoints": []
      }
    },
